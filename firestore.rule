rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every collection in this app requires a signed-in user.
    // Unauthenticated clients (including direct REST/SDK calls that
    // bypass the Angular app) are rejected.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
